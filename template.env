DISCORD_TOKEN=
GUILD_ID=
GITHUB_PAT= # Optional. Provide to sync commands with GitHub; leave blank to run from the local snapshot only
PROPOSAL_API_KEY= # Optional. Shared secret for the LLM proposal intake API (required when proposals.enabled)
FINGERPRINT_HUB_API_KEY= # Optional. FingerprintHub consumer key (fph_...); required when moderation.image_fingerprint.hub_enabled
USER_INTERACTIONS_ENCRYPTION_KEY= # Required when the greeter or a persistent classifier is enabled. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_LOG_ENCRYPTION_KEY= # Required when logging.enabled. Generate independently with the same command; do not reuse another key
FIREWORKS_API_KEY= # Optional. Required only when llm_classifier.enabled
HEALTH_PORT= # Optional. Health + proposal-intake HTTP port (default 9010)
HEALTH_HOST= # Optional. Bind address for the health server (default 127.0.0.1 / loopback). Set 0.0.0.0 only to expose deliberately behind a trusted proxy
